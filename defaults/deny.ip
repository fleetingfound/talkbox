::ffff:0:0/96
# IPv4-IPv6 Translation (local-use)     RFC 8215
64:ff9b:1::/48
# Discard-Only Address Block            RFC 6666
100::/64
# Dummy IPv6 Prefix                     RFC 9780
100:0:0:1::/64
